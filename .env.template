# FalkorDB host used by local scripts and future tests.
FALKOR_HOST=127.0.0.1

# FalkorDB port. Production compose binds 6379; test compose binds host 6380.
FALKOR_PORT=6379

# FalkorDB password passed to --requirepass. Set this in .env; never commit secrets.
FALKOR_PASSWORD=

# Optional Cognee data directory override for local development.
COGNEE_DATA_ROOT=

# Optional Cognee system directory override for local development.
COGNEE_SYSTEM_ROOT=
